{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "npx @biomejs/biome check src/robotsix_cost_monitor/web/static/ tests/robotsix_cost_monitor/web/static/",
    "format": "npx @biomejs/biome check --write src/robotsix_cost_monitor/web/static/ tests/robotsix_cost_monitor/web/static/",
    "lint:ci": "npx @biomejs/biome ci src/robotsix_cost_monitor/web/static/ tests/robotsix_cost_monitor/web/static/",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@robotsix/ui": "github:damien-robotsix/robotsix-ui#v0.1.40",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
