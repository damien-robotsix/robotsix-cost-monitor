{
  "$defs": {
    "AuthConfig": {
      "description": "HTTP Basic auth for the dashboard.\n\nThe dashboard has no other access control, so when it is exposed through\nthe central-deploy gateway (an unauthenticated reverse proxy) this MUST\nbe set \u2014 otherwise the cost data is public. When either field is empty\nthe dashboard is served open (local dev / SSH-tunnel only). ``/health``,\n``/readyz`` and ``/metrics`` are always exempt so container probes work.",
      "properties": {
        "username": {
          "default": "",
          "title": "Username",
          "type": "string"
        },
        "password": {
          "default": "",
          "format": "password",
          "title": "Password",
          "type": "string",
          "writeOnly": true
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "Settings": {
      "description": "Global dashboard settings \u2014 no per-project config (registry-driven).",
      "properties": {
        "auth": {
          "$ref": "#/$defs/AuthConfig"
        },
        "server_host": {
          "advanced": true,
          "default": "0.0.0.0",
          "title": "Server Host",
          "type": "string"
        },
        "server_port": {
          "advanced": true,
          "default": 8080,
          "title": "Server Port",
          "type": "integer"
        },
        "registry_base_url": {
          "default": "",
          "title": "Registry Base Url",
          "type": "string"
        },
        "registry_api_key": {
          "default": "",
          "format": "password",
          "title": "Registry Api Key",
          "type": "string",
          "writeOnly": true
        },
        "registry_poll_interval_seconds": {
          "advanced": true,
          "default": 300,
          "title": "Registry Poll Interval Seconds",
          "type": "integer"
        },
        "default_window_hours": {
          "advanced": true,
          "default": 168,
          "title": "Default Window Hours",
          "type": "integer"
        },
        "cache_ttl_seconds": {
          "advanced": true,
          "default": 60,
          "title": "Cache Ttl Seconds",
          "type": "integer"
        },
        "dashboard_refresh_interval_seconds": {
          "advanced": true,
          "default": 120,
          "title": "Dashboard Refresh Interval Seconds",
          "type": "integer"
        },
        "reconcile_tolerance_usd": {
          "advanced": true,
          "default": 1.0,
          "title": "Reconcile Tolerance Usd",
          "type": "number"
        },
        "reconcile_schedule_hours": {
          "advanced": true,
          "default": 24.0,
          "title": "Reconcile Schedule Hours",
          "type": "number"
        },
        "subscription_call_cap": {
          "advanced": true,
          "default": 0,
          "title": "Subscription Call Cap",
          "type": "integer"
        },
        "low_balance_threshold_usd": {
          "advanced": true,
          "default": 5.0,
          "title": "Low Balance Threshold Usd",
          "type": "number"
        },
        "data_dir": {
          "advanced": true,
          "default": ".data",
          "format": "path",
          "title": "Data Dir",
          "type": "string"
        },
        "log_format": {
          "advanced": true,
          "default": "json",
          "title": "Log Format",
          "type": "string"
        },
        "log_level": {
          "advanced": true,
          "default": "INFO",
          "title": "Log Level",
          "type": "string"
        }
      },
      "title": "Settings",
      "type": "object"
    }
  },
  "description": "Top-level config: registry-driven project discovery + global settings.\n\nProject credentials are discovered at runtime from the central-deploy\nregistry \u2014 there is no hardcoded project list.",
  "properties": {
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "title": "Config",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
